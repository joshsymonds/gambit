{
  "title": "Scout return",
  "description": "The scout's one return. Set status to blocked when a required action was not performed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "question", "answer", "evidence", "not_inspected"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "blocked"]
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_inspected": {
      "type": "string"
    },
    "bug_reproduction": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    }
  }
}
