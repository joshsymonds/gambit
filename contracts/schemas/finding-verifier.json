{
  "title": "Finding verifier return",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "results", "test_runner_requests"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "blocked"]
    },
    "results": {
      "type": "array",
      "description": "One result per supplied identifier.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence", "result"],
        "properties": {
          "id": {"type": "string"},
          "evidence": {"type": "string"},
          "result": {
            "type": "string",
            "enum": ["confirmed", "dropped", "closed", "open"]
          },
          "gap_reason": {"type": "string"}
        }
      }
    },
    "test_runner_requests": {
      "type": "array",
      "description": "Checks needing writable state, for an isolated test-runner.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "revision"],
        "properties": {
          "command": {"type": "string"},
          "revision": {"type": "string"}
        }
      }
    }
  }
}
